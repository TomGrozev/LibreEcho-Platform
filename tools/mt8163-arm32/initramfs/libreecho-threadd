#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-threadd
# Required-Start:    $network
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO
#
# Thread border router for the Lidar EFR32 radio.
#
# The per-unit radio choice is the "radio" string in the product settings file
# (/data/libreecho/config/web-config.json): thread, zigbee or none.  This
# service only handles thread; zigbee and none leave the radio alone.
#
# The RCP GBL is an owner-local payload with no home in an image: it is read
# from /data/libreecho/firmware/lidar-ot-rcp.gbl and is never packaged.  If it
# is missing the service logs that and exits without starting the agent.

DAEMON=${DAEMON:-/usr/local/sbin/otbr-agent}
PIDFILE=${PIDFILE:-/var/run/libreecho-threadd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-threadd.log}
CONFIG=${CONFIG:-/data/libreecho/config/web-config.json}
GBL=${GBL:-/data/libreecho/firmware/lidar-ot-rcp.gbl}
STATE=${STATE:-/data/libreecho/thread}
RADIO_URL=${RADIO_URL:-spinel+hdlc+uart:///dev/ttyS2?uart-baudrate=115200}
INTERFACE=${INTERFACE:-wlan0}
EFR32=${EFR32:-/usr/local/sbin/lidar-efr32}

log() { echo "libreecho-threadd: $*" > /dev/kmsg 2>/dev/null || true; }

radio_choice() {
    choice=none
    if [ -r "$CONFIG" ]; then
        choice=$(sed -n 's/.*"radio"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' \
            "$CONFIG" 2>/dev/null | sed -n '1p')
    fi
    case "$choice" in
        thread|zigbee|none) printf '%s\n' "$choice" ;;
        *) printf 'none\n' ;;
    esac
}

rcp_is_openthread() {
    version=$("$EFR32" version 2>/dev/null) || return 1
    case "$version" in
        *4f50454e544852454144*) return 0 ;;  # "OPENTHREAD" in the Spinel reply
    esac
    return 1
}

running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}

pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

is_running() { pidfile_pid >/dev/null && return 0; [ -n "$(running_pids)" ]; }

bring_up_radio() {
    [ -x "$EFR32" ] || { log "efr32 tool missing"; return 1; }
    "$EFR32" run || { log "cannot start the EFR32 application"; return 1; }
    rcp_is_openthread && return 0
    if [ ! -r "$GBL" ]; then
        log "no OpenThread RCP answers and $GBL is missing"
        return 1
    fi
    log "uploading $GBL through the EFR32 bootloader"
    "$EFR32" flash "$GBL" || { log "GBL upload failed"; return 1; }
    rcp_is_openthread || { log "the uploaded RCP does not answer"; return 1; }
    log "RCP running"
}

start_service() {
    is_running && { echo "already running"; return 0; }
    choice=$(radio_choice)
    [ "$choice" = thread ] || { log "radio choice is $choice"; echo "radio choice is $choice"; return 0; }
    [ -x "$DAEMON" ] || { log "otbr-agent is not on this image"; return 0; }
    mkdir -p "$STATE" "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")"
    chmod 700 "$STATE"
    bring_up_radio || return 1
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- \
            -I "$INTERFACE" -B "$RADIO_URL" -d 5
    else
        setsid "$DAEMON" -I "$INTERFACE" -B "$RADIO_URL" -d 5 \
            </dev/null >>"$LOGFILE" 2>&1 &
        echo "$!" >"$PIDFILE"
    fi
}

stop_service() {
    if pidfile_pid >/dev/null; then
        pid=$(pidfile_pid) && kill "$pid" 2>/dev/null
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do sleep 1; count=$((count + 1)); done
        kill -KILL "$pid" 2>/dev/null
    fi
    for stray in $(running_pids); do kill "$stray" 2>/dev/null; done
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) is_running && echo running || { echo stopped; exit 3; } ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
